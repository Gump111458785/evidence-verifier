{
  "manifest_version": 3,
  "name": "Trisight 三省",
  "version": "0.6.6",
  "minimum_chrome_version": "116",
  "description": "在 AI 对话页旁审阅回答：纠错、补充、预测。只读取页面可见问答，提示词只填入输入框，不自动发送。",
  "permissions": [
    "sidePanel",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://evidence-verifier.edgeone.dev/*",
    "https://chat.deepseek.com/*",
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://chat.deepseek.com/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*"],
      "js": ["page-adapter.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidecar.html"
  },
  "action": {
    "default_title": "Trisight 三省"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://evidence-verifier.edgeone.dev;"
  }
}
