# Optional existing OpenAI-compatible verifier. The program does not load models.
EV_MODEL_URL=http://127.0.0.1:8001/v1
EV_MODEL_NAME=your-existing-verifier-model
EV_MODEL_REVISION=pin-an-immutable-weight-revision
# EV_MODEL_KEY=provide-locally-if-required
# EV_VERIFIER_URLS=http://127.0.0.1:8001/v1,http://127.0.0.1:8002/v1
# EV_ROUTING_POLICY=least_work
# EV_REPLICA_CONCURRENCY=1
# EV_INFERENCE_PENDING=32
# EV_AGENT_URL=http://127.0.0.1:8000/v1
# EV_AGENT_NAME=your-existing-search-model
# EV_DB=/absolute/path/to/new-runtime.sqlite
# EV_CORPUS=/absolute/path/to/your-corpus.sqlite

# Installed Chrome extension ID (32 a-p letters); authorizes this exact origin only.
# EV_EXTENSION_ID=your-installed-extension-id
